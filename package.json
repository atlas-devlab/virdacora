{
  "name": "virdacora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "terralex": "pnpm --filter @terravoce/terralex cli",
    "contracts:test": "pnpm --filter @terravoce/contracts test",
    "oracle:dev": "pnpm --filter @terravoce/oracle dev",
    "demo": "pnpm --filter @terravoce/oracle demo",
    "e2e": "pnpm build && pnpm --filter @terravoce/contracts e2e",
    "case:replay": "pnpm --filter @terravoce/environmental-case replay",
    "case:verify": "pnpm --filter @terravoce/environmental-case verify",
    "case:e2e": "pnpm --filter @terravoce/contracts case:e2e",
    "forecast:replay": "pnpm --filter @terravoce/environmental-case forecast:replay",
    "forecast:verify": "pnpm --filter @terravoce/environmental-case forecast:verify",
    "forecast:diagnose": "python scripts/forecast_diagnostics.py run --output outputs/willamette-hourly-diagnostics/report.json",
    "forecast:diagnose:verify": "python scripts/forecast_diagnostics.py verify",
    "forecast:stability:preflight": "python scripts/stability_protocol.py",
    "forecast:stability:capture": "node scripts/capture-willamette-stability.mjs",
    "forecast:stability:evaluate": "python scripts/evaluate_stability.py evaluate --output docs/evidence/willamette-stability/evaluation.json.gz",
    "forecast:stability:verify": "python scripts/evaluate_stability.py verify --report docs/evidence/willamette-stability/evaluation.json.gz",
    "irrigation:replay": "python scripts/awash_irrigation.py verify && pnpm --filter @terravoce/environmental-case irrigation:replay",
    "irrigation:verify": "python scripts/awash_irrigation.py verify && pnpm --filter @terravoce/environmental-case irrigation:verify",
    "source:capture": "pnpm --filter @terravoce/environmental-case source:capture",
    "source:verify": "pnpm --filter @terravoce/environmental-case source:verify",
    "source:e2e": "pnpm --filter @terravoce/contracts source:e2e",
    "benchmark:transport": "tsx scripts/benchmark-bounded-fetch.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "license": "AGPL-3.0-only"
}
