{
  "name": "virdacora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "terralex": "pnpm --filter @terravoce/terralex cli",
    "contracts:test": "pnpm --filter @terravoce/contracts test",
    "oracle:dev": "pnpm --filter @terravoce/oracle dev",
    "demo": "pnpm --filter @terravoce/oracle demo",
    "e2e": "pnpm build && pnpm --filter @terravoce/contracts e2e",
    "benchmark:oracle": "tsx scripts/benchmark-oracle-store.ts",
    "test:postgres": "tsx scripts/run-postgres-tests.ts",
    "test:postgres:recovery": "tsx scripts/run-postgres-recovery.ts",
    "test:oracle:shutdown": "tsx scripts/run-oracle-shutdown.ts",
    "verify:evidence": "tsx scripts/verify-evidence-receipt.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "license": "AGPL-3.0-only"
}
